<mujoco model="pickup_scene">
    <include file="aubo_i10_inspire.xml"/>
    <option timestep=".002" noslip_iterations="5" noslip_tolerance="0"/>
    <statistic center="0.3 0 0.4" extent=".8"/>

    <visual>
      <headlight diffuse=".4 .4 .4" ambient=".5 .5 .5"/>
      <global azimuth="160" elevation="-20" offheight="128" offwidth="128"/>
      <quality offsamples="8"/>
    </visual>

    <asset>
      <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
      <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
      <!-- <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0 0 0" rgb2="0 0 0"/> -->
      <material name="grid" texture="grid" texrepeat="2 2" texuniform="true" reflectance="0"/>
    </asset>

    <worldbody>
        <!-- Operator sits at scene -X; overview for teleop display (not policy obs). -->
        <camera name="teleop_view" pos="-1.05 -1.05 0.62" quat="0.56553725 0.42446156 -0.42446156 -0.56553725" fovy="60"/>
        <light pos="0 0 3" dir="0 0 -1" diffuse="1 1 1" specular=".3 .3 .3"/>
        <light pos="0 -.5 .4" mode="targetbodycom" target="cube" diffuse=".8 .8 .8" specular=".3 .3 .3"/>
        <geom name="floor" size="3 3 0.01" type="plane" material="grid"/>
        <body name="cube" pos="0.13201245 -1.23968069 0.255">
            <freejoint name="cube"/>
            <!-- <geom name="cube" type="box" size="0.023 0.023 0.023" mass="0.070875" margin="0.002"/> -->
            <!-- !!! -->
            <geom name="cube_core" type="box" size="0.023 0.023 0.023" mass="0.070875" 
                  friction="0.45 0.1 0.1" contype="1" conaffinity="1" 
                  rgba="0 0 0 0" margin="0.002" solref="0.001 1" solimp="0.998 0.998 0.001"/>
            
            <geom type="box" pos="-0.025 0 0" size="0.0005 0.025 0.025" mass="0" contype="0" conaffinity="0" rgba="1 0 0 1"/>
            <geom type="box" pos="0.025 0 0" size="0.0005 0.025 0.025" mass="0" contype="0" conaffinity="0" rgba="0 1 0 1"/>
            <geom type="box" pos="0 -0.025 0" size="0.025 0.0005 0.025" mass="0" contype="0" conaffinity="0" rgba="0 0 1 1"/>
            <geom type="box" pos="0 0.025 0" size="0.025 0.0005 0.025" mass="0" contype="0" conaffinity="0" rgba="1 1 0 1"/>
            <geom type="box" pos="0 0 -0.025" size="0.025 0.025 0.0005" mass="0" contype="0" conaffinity="0" rgba="0 1 1 1"/>
            <geom type="box" pos="0 0 0.025" size="0.025 0.025 0.0005" mass="0" contype="0" conaffinity="0" rgba="1 1 1 1"/>
        </body>
        <body name="target" pos="-1.05 -1.05 0.72" quat="0 1 0 0" mocap="true">
            <geom name="target" type="box" size=".03 .03 .03" contype="0" conaffinity="0" rgba=".6 .3 .3 0"/>
        </body>

    </worldbody>

    <sensor>
        <framepos name="cube_pos" objtype="body" objname="cube"/>
        <framequat name="cube_quat" objtype="body" objname="cube"/>
    </sensor>
</mujoco>
